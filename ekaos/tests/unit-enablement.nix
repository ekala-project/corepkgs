# Declarative unit enablement and /etc/systemd/system reconciliation.
#
# Boots a VM and, from a unit that runs once boot has finished, checks
# that:
#   - units with wantedBy are pulled in at boot without `systemctl enable`
#   - administrator state (`systemctl enable`, `systemctl mask --force`,
#     drop-ins) survives re-activation
#   - managed links whose declarative entry disappeared are pruned
#
# The checker unit is itself enabled declaratively, so a regression in
# enablement means the verdict is never printed and the test fails.

{ pkgs }:

let
  inherit (pkgs) lib;

  mkBootTest = import ../lib/testing/boot-test.nix {
    inherit lib pkgs;
  };

  oneshotTrue = {
    Type = "oneshot";
    RemainAfterExit = true;
    ExecStart = "${pkgs.coreutils}/bin/true";
  };

  checker = pkgs.writeShellScript "unit-enablement-check" ''
    export PATH=${
      lib.makeBinPath [
        pkgs.coreutils
        pkgs.gnugrep
        pkgs.systemd
      ]
    }
    sys=/etc/systemd/system
    static=/etc/static/systemd/system
    failures=0

    # Run once boot is complete: powering off earlier cancels the boot
    # transaction, and systemd never logs "Startup finished".
    systemctl is-system-running --wait >/dev/null || true

    check() {
      if eval "$2"; then
        echo "UNIT-ENABLEMENT ok: $1"
      else
        echo "UNIT-ENABLEMENT FAIL: $1"
        failures=$((failures + 1))
      fi
    }

    # Declarative enablement at boot
    check "crond pulled in at boot" 'systemctl is-active --quiet crond.service'
    check "probe pulled in at boot" 'systemctl is-active --quiet enablement-probe.service'
    check "crond wants link is managed" \
      '[ "$(readlink $sys/multi-user.target.wants/crond.service)" = $static/multi-user.target.wants/crond.service ]'
    check "getty enabled declaratively" '[ -L $sys/multi-user.target.wants/getty@tty1.service ]'
    check "sync marker written" '[ -e $sys/.ekaos-managed ]'

    # Administrator state
    printf '[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=${pkgs.coreutils}/bin/true\n[Install]\nWantedBy=multi-user.target\n' \
      > $sys/imperative.service
    systemctl daemon-reload
    systemctl enable imperative.service
    systemctl mask --force enablement-probe.service
    mkdir -p $sys/crond.service.d
    printf '[Unit]\nDescription=crond (overridden)\n' > $sys/crond.service.d/override.conf

    # Managed links for a unit that is not in this generation, as left
    # behind by a generation that has since been replaced
    ln -s $static/removed.service $sys/removed.service
    ln -s $static/multi-user.target.wants/removed.service $sys/multi-user.target.wants/removed.service

    /run/current-system/bin/switch-to-configuration test

    check "imperative unit file kept" '[ -f $sys/imperative.service ]'
    check "imperative enable link kept" '[ -L $sys/multi-user.target.wants/imperative.service ]'
    check "mask kept" '[ "$(readlink $sys/enablement-probe.service)" = /dev/null ]'
    check "drop-in kept" '[ -f $sys/crond.service.d/override.conf ]'
    check "drop-in applied" 'systemctl show -p Description --value crond.service | grep -q overridden'
    check "stale unit link pruned" '[ ! -L $sys/removed.service ]'
    check "stale wants link pruned" '[ ! -L $sys/multi-user.target.wants/removed.service ]'
    check "declarative links intact" '[ -e $sys/multi-user.target.wants/crond.service ]'

    if [ "$failures" = 0 ]; then
      echo "UNIT-ENABLEMENT PASSED"
    else
      echo "UNIT-ENABLEMENT FAILED ($failures)"
    fi
    systemctl poweroff --no-block
  '';
in
mkBootTest {
  name = "unit-enablement";

  configuration = {
    boot.initrd.availableKernelModules = [
      "virtio_pci"
      "virtio_blk"
      "9p"
      "9pnet"
      "9pnet_virtio"
      "overlay"
    ];

    # Generated by service-managers/systemd.nix (services.*)
    services.crond.enable = true;

    # Generated by config/systemd-units.nix (systemd.services.*)
    systemd.services.enablement-probe = {
      description = "Declaratively enabled probe";
      wantedBy = [ "multi-user.target" ];
      serviceConfig = oneshotTrue;
    };

    systemd.services.enablement-check = {
      description = "Unit enablement checks";
      after = [ "multi-user.target" ];
      wantedBy = [ "multi-user.target" ];
      serviceConfig = {
        # Not oneshot: the boot transaction must not wait for the checks.
        Type = "exec";
        ExecStart = "${checker}";
        StandardOutput = "journal+console";
        StandardError = "journal+console";
      };
    };
  };

  expectedOutput = [ "UNIT-ENABLEMENT PASSED" ];

  timeout = 300;
}
